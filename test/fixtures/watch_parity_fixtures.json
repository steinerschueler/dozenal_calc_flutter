[
  { "expr": "3+4",        "expect": 7.0,                 "note": "single digits, base-agnostic" },
  { "expr": "B+1",        "expect": 12.0,                "note": "A/B digits + carry into base-12 ten" },
  { "expr": "A+B",        "expect": 21.0,                "note": "both over-9 digits" },
  { "expr": "10-3",       "expect": 9.0,                 "note": "base-12 '10' = twelve" },
  { "expr": "100-1",      "expect": 143.0,               "note": "base-12 '100' = 144" },
  { "expr": "5*3",        "expect": 15.0,                "note": "multiply" },
  { "expr": "10*2",       "expect": 24.0,                "note": "twelve times two" },
  { "expr": "B*B",        "expect": 121.0,               "note": "eleven squared" },
  { "expr": "100/2",      "expect": 72.0,                "note": "144 / 2" },
  { "expr": "10/8",       "expect": 1.5,                 "note": "twelve / eight" },
  { "expr": "1/3",        "expect": 0.3333333333333333,  "note": "non-terminating f64 division, identical on both" },
  { "expr": "-5+3",       "expect": -2.0,                "note": "leading unary minus" },
  { "expr": "5*-3",       "expect": -15.0,               "note": "unary minus after operator" },
  { "expr": "2^3",        "expect": 8.0,                 "note": "power" },
  { "expr": "10^2",       "expect": 144.0,               "note": "twelve squared via ^" },
  { "expr": "4^(1/2)",    "expect": 2.0,                 "note": "square root via ^(1/2)" },
  { "expr": "100^(1/2)",  "expect": 12.0,                "note": "sqrt(144) = twelve" },
  { "expr": "8^(1/3)",    "expect": 2.0,                 "note": "cube root via ^(1/3)" },
  { "expr": "2^(1/2)",    "expect": 1.4142135623730951,  "note": "irrational: proves both compute pow identically" },
  { "expr": "(2+3)*4",    "expect": 20.0,                "note": "parentheses override precedence" },
  { "expr": "2+3*4",      "expect": 14.0,                "note": "precedence: * before +" },
  { "expr": "0.6",        "expect": 0.5,                 "note": "base-12 fraction 0.6 = one half" },
  { "expr": "0.6+0.6",    "expect": 1.0,                 "note": "two halves" },
  { "expr": "(B+1)/3",    "expect": 4.0,                 "note": "nested parens + division" }
]
