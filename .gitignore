# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Claude Code local settings
.claude/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Generated by `flutter gen-l10n` (driven by `generate: true` + l10n.yaml on
# every `flutter pub get`). The ARB source files in lib/l10n/ are committed;
# the produced Dart classes are build artifacts.
/lib/l10n/app_localizations.dart
/lib/l10n/app_localizations_*.dart

# Generated by tool/sync_play_listings.dart. The source of truth lives in
# store/play-store/listing.*.md and build<N>-release-notes.txt; this tree is just the
# layout Gradle Play Publisher expects. Run the sync script before
# `./gradlew publishListing` / `publishBundle`.
/android/app/src/main/play/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing — never commit. Defensive: matches any *.jks/keystore plus
# the properties file that holds the absolute path and passwords.
**/android/key.properties
**/android/app/upload-keystore.jks
**/*.jks
**/*.keystore
key.properties

# Throwaway converter preview renders
tool/preview/

# Native watchOS companion (watch/) — build outputs and the project that
# xcodegen regenerates from watch/project.yml. Only Sources/ + project.yml
# are versioned.
watch/build/
watch/DozenalWatch.xcodeproj/

# fastlane: generated App Store metadata (source of truth is store/app-store/*.md
# via tool/sync_appstore_metadata.dart) + captured screenshots + run artifacts.
# Committed: fastlane/Appfile, fastlane/Deliverfile only.
fastlane/metadata/
fastlane/screenshots/
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/

# Lokale Geräte-Testdoku (Serials, Entsperren) — bewusst NICHT versioniert,
# darf nicht auf GitHub (siehe CLAUDE.md). Inhalt: docs/local/device-testing.md
/docs/local/

# Graphify-Wissensgraph (lokales Claude-Code-Navigationstool, nicht Teil der
# App). graphify-out/ = generierter Graph; .graphifyignore = lokale Scope-Config.
# Bewusst nicht versioniert — gehört nicht ins veröffentlichte Repo. Neu bauen
# mit `graphify extract .`.
/graphify-out/
/.graphifyignore

# Lokaler Audit-Bericht (Code-Review-Artefakt, nicht Teil der App).
/AUDIT-REPORT.md
