# fastlane deliver — pushes localized App Store listing metadata for Dozenal
# Calc to App Store Connect. The text in fastlane/metadata/ is GENERATED by
# `dart run tool/sync_appstore_metadata.dart` from store/app-store/*.md (the
# single source of truth) — never edit fastlane/metadata/ by hand.
#
# Binaries are built + uploaded separately via altool (the device-less archive
# workflow), so binary upload is skipped here. The SAME metadata serves iOS and
# macOS — pass the platform + its screenshot folder on the CLI:
#
#   fastlane deliver --api_key_path ~/keys/appstore_api_key.json \
#     --platform ios --screenshots_path fastlane/screenshots/ios
#   fastlane deliver --api_key_path ~/keys/appstore_api_key.json \
#     --platform osx --screenshots_path fastlane/screenshots/osx
#
# Drop --submit_for_review to push metadata only; the user submits in the
# browser after adding screenshots / checking the listing.

app_identifier("app.weltanschauung.dozenal")

skip_binary_upload(true)
# overwrite_screenshots replaces the ENTIRE screenshot set for the platform.
# The screenshots_path MUST therefore hold the COMPLETE set, or you wipe the
# others: for iOS that means iPhone + iPad + Apple Watch together (sources:
# iPhone/iPad in store/screenshots/ios/{6.7,ipad13}, watch captured live).
overwrite_screenshots(true)
force(true)                          # don't prompt to confirm the HTML preview
run_precheck_before_submit(false)
submit_for_review(false)
automatic_release(false)

# Category, age rating, pricing and the App Privacy answers are managed in App
# Store Connect, NOT from the repo — no app-level metadata files are generated,
# so deliver leaves those fields untouched.
